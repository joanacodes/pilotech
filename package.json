{
  "name": "pilotech-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site unifié Pilotech (climatisation Toshiba + ventilation VMI) — Jekyll + Tailwind précompilé",
  "scripts": {
    "css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/css/site.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/css/site.css --watch",
    "preview": "python3 scripts/preview.py"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.5",
    "tailwindcss": "^3.4.19"
  }
}
